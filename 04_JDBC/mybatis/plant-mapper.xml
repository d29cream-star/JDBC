<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="plantMapper">
  
	  <insert id="save"
	  		  parameterType="plant">
	  		INSERT
	  		  INTO
	  		       HOUSEPLANT
	  		VALUES
	  			   (
	  			   SEQ_PLANT_NO.NEXTVAL
	  			  , #{plantType}
	  			  , #{plantName}
	  			  	)
	  </insert>
  
  	  <select id="view"
  	  		  resultType="plant">
  	  		 
			SELECT
				    PLANT_NO plantNo
				 ,  PLANT_TYPE plantType
				 ,  PLANT_NAME plantName
			  FROM	
			  		HOUSEPLANT
			 ORDER
			 	BY
			 		PLANT_NO	  
  	 
  	  </select>

  </mapper>

  