<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="plantMapper">
  
		<sql id="plantColumn">
				SELECT
					    PLANT_NO
					 ,  PLANT_TYPE
					 ,  PLANT_NAME
				  FROM	
				  		HOUSEPLANT
		</sql>

	
	  <insert id="save"
	  		  parameterType="plant">
	  		INSERT
	  		  INTO
	  		       HOUSEPLANT
	  		VALUES
	  			   (
	  			   SEQ_PLANT_NO.NEXTVAL
	  			  , #{plantType}
	  			  , #{plantName}
	  			  	)
	  </insert>
  
  	  <select id="view"
  	  		  resultType="plant">
  	  		 
		<include refid="plantColumn" />
			 ORDER
			 	BY
			 		PLANT_NO	  
  	 
  	  </select>
  	  
  	  <update id="edit"
  	  		  parameterType="plant">
  	  		  UPDATE
  	  		  		 HOUSEPLANT
  	  		     SET
  	  		    	 PLANT_NAME = #{plantName}
  	  		       , PLANT_TYPE = #{plantType}
  	  		   WHERE
  	  		   		 PLANT_NO = #{plantNo}
  	  		   		 
  	  </update>
  	  
  	  <delete id="delete"
  	  		  parameterType="_int">
  	  		  DELETE
  	  		    FROM
  	  		   		 HOUSEPLANT 	  
  	  		   WHERE
  	  		  		 PLANT_NO = #{plantNo}
  	  </delete>

	

	  <select id="oneView"
			  resultType="plant"
			  parameterType="_int">
			<include refid="plantColumn" />
			 WHERE
			   		PLANT_NO = #{plantNo}  			
	  </select>
	  
	  
	  
	  <select id="findByType"
	    	  resultType="plant"
	    	  parameterType="string">
	  	  <include refid="plantColumn" />
	  		   WHERE
	  		   		 PLANT_TYPE LIKE '%'|| #{keyword} ||'%'
	  		   ORDER
	  		   	  BY
	  		   	  	 PLANT_NO
	  </select>
	

  </mapper>

  