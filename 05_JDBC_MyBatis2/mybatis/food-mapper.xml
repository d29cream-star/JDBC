<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
  
  <mapper namespace="foodMapper">
  		<resultMap id="foodAndReviews"
  				   type="com.kh.snackfood.model.dto.SnackFoodDto">
  			<id column="FOOD_NO" property="foodNo" />
  			<result column="FOOD_NAME" property="foodName" />
  		  	<result column="PRICE" property="price" />
  		  	<collection property="reviews" ofType="com.kh.snackfood.model.dto.FoodReviewDto">
  		  		<id column="REVIEW_NO" property="reviewNo" />
  		  		<result column="REVIEW_CONTENT" property="reviewContent"/>	
  		   	</collection>
  		</resultMap>
  		  		
  		<select id="selectFoodList"
  				resultMap="foodAndReviews">
  			SELECT
  					FOOD_NO
  				 ,	FOOD_NAME
  				 ,	PRICE
  				 , 	REVIEW_NO	
  				 ,	REVIEW_CONTENT
  			  FROM	
  			  		SNACK_FOOD
  			  LEFT
  			  JOIN
  			  		FOOD_REVIEW USING(FOOD_NO)
  			 ORDER
  			 	BY
  			 		FOOD_NO DESC
  		  		
  		</select>
  		
  		<select id="selectByCondition"
  				resultMap="foodAndReviews">
  			SELECT
  					FOOD_NAME
  				 , 	CATEGORY
  				 , 	REVIEW_WRITER
  				 , 	REVIEW_CONTENT
  			  FROM
  			  		SNACK_FOOD
  			  LEFT		
  			  JOIN
  			  		FOOD_REVIEW ON(SNACK_FOOD.FOOD_NO = FOOD_REVIEW.FOOD_NO)
  			 WHERE
  			 		<choose>
  			 		  <when test="menuNo == 1">
  			 		FOOD_NAME LIKE '%' || #{keyword} ||'%'
  			 		  </when>
  			 		  <when test="menuNo == 2"> 
  			 		REVIEW_WRITER LIKE '%' || #{keyword} ||'%'
  			 		  </when>
  			 		  <when test="menuNo == 3">
  			 		REVIEW_CONTENT LIKE '%' || #{keyword} ||'%'
  					  </when>
  					  <otherwise>
  					  	SNACK_FOOD.FOOD_NAME OR 1 = 1 
  					  </otherwise>
  					</choose>
  			 ORDER
  			 	BY
  			 		SNACK_FOOD.FOOD_NO DESC
  		</select>
  		  		
 		<!-- <insert id="insertFood"
